# Base de Datos - Supabase Postgres
# Obtener desde: https://supabase.com/dashboard
#   -> Project -> Settings -> Database -> Connection string
#   Usar "Session pooler" en puerto 5432 (compatible con Hibernate/JPA).
# Despues copiar este archivo a .env y completar los valores reales.
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=tu_password_de_supabase

# JWT
JWT_SECRET=tu_secreto_super_seguro_de_al_menos_32_caracteres

# Server
PORT=8080

# Brevo SMTP (task004) - Cuenta gratuita en https://www.brevo.com/
#   1) Crea una cuenta y verifica el correo.
#   2) Sidebar -> SMTP & API -> SMTP -> "Generate a new SMTP key".
#   3) Sidebar -> Senders, Domains & IPs -> Senders -> agrega y verifica un
#      remitente (puede ser tu mismo correo personal).
# Deja estos vacios y usa SPRING_PROFILES_ACTIVE=dev para que los correos se
# registren en el log sin enviarse realmente.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=

# URL base del frontend - usada para construir el enlace /signup-finish.
FRONTEND_BASE_URL=http://localhost:5173

# Perfil de Spring (deja 'dev' hasta tener credenciales reales de Brevo).
SPRING_PROFILES_ACTIVE=dev
