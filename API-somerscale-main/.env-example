# Base de Datos - Supabase Postgres
# Dashboard -> Project -> Settings -> Database -> Connection string.
# Usa "Session pooler" en puerto 5432 (compatible con Hibernate/JPA).
# Copia este archivo a .env y completa los valores reales (.env NO se commitea).
SPRING_DATASOURCE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-us-west-1.pooler.supabase.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.<PROJECT_REF>
SPRING_DATASOURCE_PASSWORD=<PASSWORD>

# JWT (generar con: openssl rand -hex 32)
JWT_SECRET=<RANDOM_HEX_32>

# Servidor
PORT=8080

# Correo - Resend SMTP (https://resend.com)
#   1) Crea una cuenta en resend.com y verifica el correo.
#   2) Dashboard -> API Keys -> "Create API Key" (Sending access) -> copia el valor 're_...'.
#   3) Para demo usa MAIL_FROM=onboarding@resend.dev (no requiere verificar dominio).
# Free tier: 100 correos/dia, 3000/mes.
# Deja MAIL_PASSWORD vacio y usa SPRING_PROFILES_ACTIVE=dev para que los correos
# se registren en el log en lugar de enviarse realmente.
MAIL_HOST=smtp.resend.com
MAIL_PORT=2587
MAIL_USERNAME=resend
MAIL_PASSWORD=<resend-api-key-starting-with-re_>
MAIL_FROM=onboarding@resend.dev

# URL base del frontend - usada para construir el enlace /signup-finish.
FRONTEND_BASE_URL=http://localhost:5173

# Perfil de Spring ('dev' = correos al log; 'prod' = SMTP real con Resend).
SPRING_PROFILES_ACTIVE=dev

# Cifrado AES-GCM para huespedes.numero_documento (task005).
# Generar dos llaves distintas con: openssl rand -base64 32
APP_ENCRYPTION_KEY=<base64-32-bytes>
APP_HMAC_KEY=<base64-32-bytes>

# Google Places API (task011) - reviews diarios desde Places API (New).
#   1) console.cloud.google.com -> habilitar "Places API (New)" + tarjeta de billing.
#   2) Crear API key restringida a Places API (New).
#   3) Encontrar el Place ID del hotel via Place ID Finder.
# Si GOOGLE_PLACES_API_KEY queda vacio, el sync usa los fixtures locales en
# tests/google-places-{es,en}.json (modo demo offline para el MVP).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PLACE_ID=ChIJSomerscalesDummy
GOOGLE_PLACES_FIXTURE_DIR=../tests

# TripAdvisor Content API (task012) - reviews diarios via free tier.
#   1) developer-tripadvisor.com -> Content API -> aplicar al free tier
#      (aprobacion 1-3 dias habiles).
#   2) Una vez aprobada la key, encontrar el location_id con:
#        GET /api/v1/location/search?key=...&searchQuery=Somerscales
#   3) Restringir la key a Content API en el dashboard de TripAdvisor.
# Si TRIPADVISOR_API_KEY queda vacio, el sync usa los fixtures locales en
# tests/tripadvisor-{es,en}.json (modo demo offline para el MVP).
TRIPADVISOR_API_KEY=
TRIPADVISOR_LOCATION_ID=1234567
TRIPADVISOR_FIXTURE_DIR=../tests

# Google Gemini 2.5 Flash (task013) - clasifica reviews ya ingestados con
# sentiment + categorias + resumen + frases clave.
#   1) aistudio.google.com -> "Get API key" -> free tier (sin tarjeta).
#   2) Pegar el valor 'AIza...' en GEMINI_API_KEY abajo.
# Si GEMINI_API_KEY queda vacio, el classifier se desactiva (los reviews
# quedan sin sentiment). El cron en application.properties es diario UTC 05:00.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
