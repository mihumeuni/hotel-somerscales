# Base de Datos - Supabase Postgres
# Dashboard -> Project -> Settings -> Database -> Connection string.
# Usa "Session pooler" en puerto 5432 (compatible con Hibernate/JPA).
# Copia este archivo a .env y completa los valores reales (.env NO se commitea).
SPRING_DATASOURCE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-us-west-1.pooler.supabase.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.<PROJECT_REF>
SPRING_DATASOURCE_PASSWORD=<PASSWORD>

# JWT (generar con: openssl rand -hex 32)
JWT_SECRET=<RANDOM_HEX_32>

# Servidor
PORT=8080

# Correo - Gmail SMTP con App Password (task015)
#   1) En la cuenta Gmail: myaccount.google.com/security -> activar verificacion en 2 pasos.
#   2) Visitar myaccount.google.com/apppasswords (solo aparece con 2FA activa).
#   3) Crear App Password: app="Mail", dispositivo="Other", nombre "somerscales-mvp".
#   4) Copiar la clave de 16 caracteres (mostrada una sola vez; eliminar espacios).
# Free tier: 500 correos/dia. Cambiar de proveedor (Mailjet, SES, Workspace, etc.)
# es un swap de estas variables; ningun cambio de codigo.
# Deja MAIL_PASSWORD vacio y usa SPRING_PROFILES_ACTIVE=dev para registrar los
# correos en el log en vez de enviarlos por SMTP.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<tu-cuenta@gmail.com>
MAIL_PASSWORD=<app-password-de-16-caracteres-sin-espacios>
MAIL_FROM=<tu-cuenta@gmail.com>

# URL base del frontend - usada para construir el enlace /signup-finish.
FRONTEND_BASE_URL=http://localhost:5173

# Perfil de Spring ('dev' = correos al log; cualquier otro perfil/vacio = SMTP real con Gmail).
SPRING_PROFILES_ACTIVE=dev

# Cifrado AES-GCM para huespedes.numero_documento (task005).
# Generar dos llaves distintas con: openssl rand -base64 32
APP_ENCRYPTION_KEY=<base64-32-bytes>
APP_HMAC_KEY=<base64-32-bytes>

# Google Places API (task011) - reviews diarios desde Places API (New).
#   1) console.cloud.google.com -> habilitar "Places API (New)" + tarjeta de billing.
#   2) Crear API key restringida a Places API (New).
#   3) Encontrar el Place ID del hotel via Place ID Finder.
# Si GOOGLE_PLACES_API_KEY queda vacio, el sync usa los fixtures locales en
# tests/google-places-{es,en}.json (modo demo offline para el MVP).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PLACE_ID=ChIJSomerscalesDummy
GOOGLE_PLACES_FIXTURE_DIR=../tests

# TripAdvisor Content API (task012) - reviews diarios via free tier.
#   1) developer-tripadvisor.com -> Content API -> aplicar al free tier
#      (aprobacion 1-3 dias habiles).
#   2) Una vez aprobada la key, encontrar el location_id con:
#        GET /api/v1/location/search?key=...&searchQuery=Somerscales
#   3) Restringir la key a Content API en el dashboard de TripAdvisor.
# Si TRIPADVISOR_API_KEY queda vacio, el sync usa los fixtures locales en
# tests/tripadvisor-{es,en}.json (modo demo offline para el MVP).
TRIPADVISOR_API_KEY=
TRIPADVISOR_LOCATION_ID=1234567
TRIPADVISOR_FIXTURE_DIR=../tests

# Google Gemini 2.5 Flash (task013) - clasifica reviews ya ingestados con
# sentiment + categorias + resumen + frases clave.
#   1) aistudio.google.com -> "Get API key" -> free tier (sin tarjeta).
#   2) Pegar el valor 'AIza...' en GEMINI_API_KEY abajo.
# Si GEMINI_API_KEY queda vacio, el classifier se desactiva (los reviews
# quedan sin sentiment). El cron en application.properties es diario UTC 05:00.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cloudbeds PMS (task030 pipeline + task033 live client).
#   - Sin CLOUDBEDS_CLIENT_ID -> MockCloudbedsApiClient lee tests/huespedes.csv
#     (modo demo, sin red). Es el default del MVP.
#   - Con CLOUDBEDS_CLIENT_ID + CLOUDBEDS_CLIENT_SECRET + CLOUDBEDS_PROPERTY_ID
#     -> LiveCloudbedsApiClient hace OAuth2 client-credentials y pagina
#     /getReservations. El cron Sunday 03:00 America/Santiago empieza a
#     traer datos reales en el siguiente domingo.
# Pasos de activacion:
#   1) Cloudbeds dashboard -> My Account -> API Credentials -> Create a
#      Server-to-Server App. Copiar client_id + client_secret.
#   2) Property ID esta en la URL del dashboard (/admin/property/{id}).
#   3) Pegar las 3 variables aqui y reiniciar el backend; o "Sincronizar
#      ahora" desde Settings -> Sincronizacion Cloudbeds.
# Overrides opcionales (solo si Cloudbeds cambia su gateway o scope):
#   CLOUDBEDS_BASE_URL    default: https://api.cloudbeds.com/api/v1.2
#                         (docs publicos usan hotels.cloudbeds.com)
#   CLOUDBEDS_TOKEN_URL   default: ${CLOUDBEDS_BASE_URL}/oauth/access_token
#   CLOUDBEDS_SCOPE       default: read:reservation read:guest
#   CLOUDBEDS_PAGE_SIZE   default: 100
CLOUDBEDS_CLIENT_ID=
CLOUDBEDS_CLIENT_SECRET=
CLOUDBEDS_PROPERTY_ID=
